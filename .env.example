# =============================================================================
# Медицинский консультант — шаблон переменных окружения.
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# Файл .env НИКОГДА не коммитится (см. .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=Медицинский консультант
# Каталог загрузок. В Docker: /app/data/uploads (том backend_uploads).
UPLOADS_DIR=/app/data/uploads

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Пароль БД. Используется docker-compose для сервиса postgres.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-strong-password
# Строка подключения backend.
#   Docker:                 postgresql://medical:<пароль>@postgres:5432/medical_consultant
#   Локально (без Docker):  postgresql://medical:<пароль>@localhost:5432/medical_consultant
DATABASE_URL=postgresql://medical:change-me-strong-password@postgres:5432/medical_consultant

# -----------------------------------------------------------------------------
# JWT / сессии
# -----------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО задайте собственный секрет. В production приложение не стартует
# со значением по умолчанию или плейсхолдером из этого шаблона.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
# Срок жизни токена в минутах (10080 = 7 дней).
JWT_EXPIRE_MINUTES=10080
# Базовый URL фронтенда — используется в ссылках сброса пароля.
FRONTEND_URL=https://помощники-консультанты.рф

# -----------------------------------------------------------------------------
# LLM-провайдеры
# -----------------------------------------------------------------------------
# AITunnel — основные текстовые модели (чат, препараты, нутрициолог, разбор).
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# ProxyAPI — vision/изображения и fallback.
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модели по типам задач (значения по умолчанию можно не менять).
SYMPTOMS_MODEL=qwen3.5-plus-02-15
MEDICATIONS_MODEL=claude-sonnet-4.6
COMPLEX_SYMPTOMS_MODEL=deepseek-r1-0528
REVIEW_MODEL=claude-opus-4-7
IMAGING_MODEL=gpt-4o-mini
NUTRITION_MODEL=claude-sonnet-4.6
ADMIN_ENRICHMENT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# SMTP (опционально — для восстановления пароля)
# -----------------------------------------------------------------------------
# Без SMTP эндпоинт «Забыли пароль?» вернёт 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Администратор и ops-мониторинг
# -----------------------------------------------------------------------------
# Email администратора — даёт доступ к /api/admin/*.
ADMIN_EMAIL=
# Уведомления ops. Пусто — уведомления не отправляются.
OPS_NOTIFY_URL=
OPS_TOKEN=

# -----------------------------------------------------------------------------
# Модерация регистрации
# -----------------------------------------------------------------------------
# Автоодобрение новых заявок через N минут после создания.
# 0 (по умолчанию) — выключено, заявки одобряет администратор вручную.
AUTO_APPROVE_AFTER_MINUTES=0

# -----------------------------------------------------------------------------
# Платежи (YooKassa)
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Автозачисление кредитов по webhook YooKassa. false — начисления делает
# администратор вручную (кошелёк пользователя). true — включить с проверкой
# статуса платежа через API YooKassa перед зачислением.
YOOKASSA_WEBHOOK_ENABLED=false

# -----------------------------------------------------------------------------
# Yandex Vision OCR (распознавание документов)
# -----------------------------------------------------------------------------
YANDEX_OCR_API_KEY=
YANDEX_OCR_FOLDER_ID=
YANDEX_OCR_BASE_URL=https://ocr.api.cloud.yandex.net/ocr/v1
YANDEX_OCR_CREDITS_PER_PAGE=2

# -----------------------------------------------------------------------------
# Frontend (только на этапе сборки Vite)
# -----------------------------------------------------------------------------
# В Docker оставьте пустым — nginx проксирует /api на backend.
# Для локальной разработки: VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
